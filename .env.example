# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never expose in a NEXT_PUBLIC_* variable
SUPABASE_SECRET_KEY=

# Authenticates /api/cron/tick (also stored in Supabase Vault as cron_secret)
CRON_SECRET=

# Web Push (generate with: pnpm dlx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Comma-separated list of the two emails allowed to use the app
ALLOWED_EMAILS=

# Public URL of the deployed app, used in push links
APP_URL=http://localhost:3000
